<?php

use Mlbrgn\MediaLibraryExtensions\Tests\Models\Blog;

/** @noinspection InvalidDatasetNameCaseInspection */

beforeEach(function () {
    config(['media-library.disk_name' => 'mle_demo_disk']);
});

dataset('blog_test_matrix', [
    'plain + xhr' => ['plain', true],
    'plain + no xhr' => ['plain', false],
]);

it('can manage featured image (single collection)', function (string $theme, bool $useXhr) {
    $blog = Blog::first();
    $fixture = $this->getRandomFixture();

    $page = $this->visit("/blog-showcase?theme={$theme}&use_xhr=" . ($useXhr ? '1' : '0'))
        ->assertNoJavaScriptErrors()
        ->assertSee('Blog Integration Showcase')
        ->wait(2)
        ->assertPresent('#blog-main-mms [data-mle-media-input]');

    // Attach to the input using a more specific selector
    $page->attach('#blog-main-mms [data-mle-media-input]', $fixture)
        ->click('#blog-main-mms [data-mle-media-upload-button]')
        ->waitForText(__('medialibrary-extensions::messages.upload_success'));

    // Delete image to allow replacement
    $page->click('#blog-main-mms [data-mle-media-delete-button]')
        ->waitForText(__('medialibrary-extensions::messages.medium_removed'));

    $blog->refresh();
    $this->assertCount(0, $blog->getMedia('blog-main'));

    $page->page()->close();
})->with('blog_test_matrix')->group('browser')->flaky();

it('can manage gallery (multiple collection)', function (string $theme, bool $useXhr) {
    $blog = Blog::first();

    $page = $this->visit("/blog-showcase?theme={$theme}&use_xhr=" . ($useXhr ? '1' : '0'))
        ->assertNoJavaScriptErrors()
        ->assertSee(__('medialibrary-extensions::messages.upload_media'))
        ->wait(2)
        ->assertPresent('#blog-gallery-mmm [data-mle-media-input]');

    // Upload first image
    $page->attach('#blog-gallery-mmm [data-mle-media-input]', $this->getRandomFixture())
        ->click('#blog-gallery-mmm [data-mle-media-upload-button]')
        ->waitForText(__('medialibrary-extensions::messages.upload_success'));

    // Upload second image
    $page->attach('#blog-gallery-mmm [data-mle-media-input]', $this->getRandomFixture())
        ->click('#blog-gallery-mmm [data-mle-media-upload-button]')
        ->waitForText(__('medialibrary-extensions::messages.upload_success'));

    $blog->refresh();
    $this->assertCount(2, $blog->getMedia('blog-gallery'));

    $page->page()->close();
})->with('blog_test_matrix')->group('browser')->flaky();

it('can associate YouTube videos', function (string $theme, bool $useXhr) {
    $blog = Blog::first();
    $youtubeUrl = 'https://www.youtube.com/watch?v=dQw4w9WgXcQ';

    $page = $this->visit("/blog-showcase?theme={$theme}&use_xhr=" . ($useXhr ? '1' : '0'))
        ->assertNoJavaScriptErrors()
        ->assertSee(__('medialibrary-extensions::messages.youtube_video_url'))
        ->wait(2)
        ->assertPresent('#blog-youtube-mms [data-mle-youtube-input]');

    $page->type('#blog-youtube-mms [data-mle-youtube-input]', $youtubeUrl)
        ->click('#blog-youtube-mms [data-mle-youtube-upload-button]')
        ->waitForText(__('medialibrary-extensions::messages.youtube_video_uploaded'));

    $blog->refresh();
    $this->assertCount(1, $blog->getMedia('blog-youtube'));
    $this->assertEquals($youtubeUrl, $blog->getMedia('blog-youtube')->first()->getCustomProperty('youtube-url'));

    $page->page()->close();
})->with('blog_test_matrix')->group('browser')->flaky();

it('works with Media Lab', function (string $theme, bool $useXhr) {
    $blog = Blog::first();
    // Pre-upload an image for Media Lab
    $blog->addMedia($this->getRandomFixture())->toMediaCollection('blog-lab');

    $page = $this->visit("/blog-showcase?theme={$theme}&use_xhr=" . ($useXhr ? '1' : '0'))
        ->assertNoJavaScriptErrors()
        ->assertSee(__('medialibrary-extensions::messages.edit'))
        ->wait(2)
        ->assertPresent('#blog-lab-mms [data-mle-media-edit-button]')
        ->click('#blog-lab-mms [data-mle-media-edit-button]');

    // Wait for Media Lab modal
    $page->assertPresent('#blog-lab-mms [data-mle-image-editor-modal]')
        ->wait(1)
        ->assertPresent('[data-click-action="save"]')
        ->click('[data-click-action="save"]')
        ->waitForText(__('medialibrary-extensions::messages.medium_replaced'));

    $blog->refresh();
    $this->assertCount(1, $blog->getMedia('blog-lab'));

    $page->page()->close();
})->with('blog_test_matrix')->group('browser')->flaky();
