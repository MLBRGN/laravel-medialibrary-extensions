<div id="media-carousel-bs6-crs"
     data-base-id="media-carousel-bs6"
     class="mle-component mle-theme-bootstrap-6 mle-media-carousel media-carousel mle-media-carousel-empty carousel carousel-overlay slide mle-width-100 mle-height-100"
        data-mle-carousel
>

    
    <div
        class="mle-media-carousel-indicators carousel-indicators mle-display-none"
        data-mle-carousel-indicators
    >
            </div>

    
    <div class="mle-media-carousel-inner carousel-inner">
                    <div class="mle-media-carousel-item active"
                data-mle-carousel-item
            >
                <div class="mle-media-carousel-item-container">
                    <span class="mle-no-media mle-media-responsive">No media.</span>
                </div>
            </div>
            </div>

    
    <button
        class="mle-media-carousel-control-prev carousel-control-prev disabled"
        type="button"
        data-bs-target="#media-carousel-bs6-crs" 
        data-bs-slide="prev" 
        title="Previous"
        data-mle-carousel-prev
    >
        <span class="mle-media-carousel-control-prev-icon" aria-hidden="true">
        <span 
        role="img" 
        aria-label="Previous" 
        title="Previous">?</span>
        </span>
        <span class="mle-visually-hidden">Previous</span>
    </button>
    <button
        class="mle-media-carousel-control-next carousel-control-next disabled"
        type="button"
        data-bs-target="#media-carousel-bs6-crs"
        data-bs-slide="next"
        title="Next"
        data-mle-carousel-next
    >
        <span class="mle-media-carousel-control-next-icon" aria-hidden="true">
            <span 
        role="img" 
        aria-label="Next" 
        title="Next">?</span>
        </span>
        <span class="mle-visually-hidden">Next</span>
    </button>
</div>
